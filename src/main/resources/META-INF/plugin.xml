
<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.rutvik.flutter_developer_tools</id>

    <!-- Mark incompatibility with Flutter Enhancement Suite -->
    <incompatible-with>de.mariushoefler.flutter_enhancement_suite</incompatible-with>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Flutter Developer Tools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://rutvik.dev">Rutvik Dev</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <h2>Flutter and Dart tools for everyday work</h2>

        <p>
            Small tools that make Flutter and Dart work faster: smarter pubspec.yaml editing,
            package and code docs on hover, better navigation, and helpful inline hints.
        </p>

        <h3>Package management</h3>
        <ul>
            <li>Auto-complete pub.dev packages as you type, with a Flutter Favorites badge</li>
            <li>Inline update hints, with a safe upgrade option that skips major versions</li>
            <li>One-click upgrade, with an option to run flutter pub get for you</li>
            <li>Warnings for discontinued and Dart 3 incompatible packages</li>
        </ul>

        <h3>Documentation</h3>
        <ul>
            <li>Hover a package to read its README, or a version to read its CHANGELOG</li>
            <li>Dart docs with code samples highlighted to match your IDE theme</li>
            <li>Works with GitHub, GitLab, Bitbucket, Codeberg, and SourceHut</li>
            <li>Understands packages inside monorepos</li>
        </ul>

        <h3>Navigation</h3>
        <ul>
            <li>Click a package name to open its pub.dev page</li>
            <li>Breadcrumbs for classes, methods, functions, constructors, mixins, enums, and extensions, with custom icons</li>
            <li>Code lens with usage and implementation counts</li>
        </ul>

        <h3>Code hints</h3>
        <ul>
            <li>Parameter names for positional arguments</li>
            <li>Inferred types for var, final, and const</li>
            <li>Options to control how hints are shown</li>
        </ul>

        <h3>Quick actions</h3>
        <ul>
            <li>Run flutter gen-l10n from .arb files</li>
            <li>Run build_runner build and watch from generated files</li>
        </ul>

        <p>
            Requirements: IntelliJ IDEA 2025.2 or newer, with the Flutter and Dart plugins installed.
        </p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends>io.flutter</depends>
    <depends>Dart</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Application Services -->
        <applicationService
                serviceImplementation="dev.rutvik.flutter_developer_tools.services.PubPackageCacheService"/>

        <!-- ARB File Notification Provider -->
        <editorNotificationProvider
                implementation="dev.rutvik.flutter_developer_tools.arb.ArbFileNotificationProvider"/>

        <!-- Build Runner Notification Provider -->
        <editorNotificationProvider
                implementation="dev.rutvik.flutter_developer_tools.buildRunner.BuildRunnerFileNotificationProvider"/>

        <!-- Pub Package Completion -->
        <completion.contributor
                language="yaml"
                order="first"
                implementationClass="dev.rutvik.flutter_developer_tools.pubspec.completions.PubPackageCompletionContributor"/>

        <!-- Reference Contributor -->
        <psi.referenceContributor
                language="yaml"
                implementation="dev.rutvik.flutter_developer_tools.pubspec.referenceContributor.PubPackageReferenceContributor"/>

        <!-- Documentation Provider -->
        <lang.documentationProvider
                language="yaml"
                implementationClass="dev.rutvik.flutter_developer_tools.pubspec.documentation.PubPackageDocumentationProvider"
                order="first, before YamlJsonSchemaDocumentationProvider"/>

        <!-- Annotator -->
        <annotator language="yaml" order="first"
                   implementationClass="dev.rutvik.flutter_developer_tools.pubspec.annotator.PubPackageAnnotator"/>

        <!-- Inlay Hint Provider for Version Updates -->
        <codeInsight.inlayProvider
                language="yaml"
                implementationClass="dev.rutvik.flutter_developer_tools.pubspec.hints.PubspecVersionInlayHintProvider"/>

        <!-- Dart Parameter Hints -->
        <codeInsight.declarativeInlayProvider
                implementationClass="dev.rutvik.flutter_developer_tools.dart.hints.DartDeclarativeParameterHintsProvider"
                providerId="dart.declarative.parameter.hints"
                language="Dart"
                group="PARAMETERS_GROUP"
                isEnabledByDefault="true"
                bundle="messages.FlutterToolsBundle"
                nameKey="dart.parameter.hints.name"/>

        <!-- Dart Type Hints -->
        <codeInsight.declarativeInlayProvider
                implementationClass="dev.rutvik.flutter_developer_tools.dart.hints.DartDeclarativeTypeHintsProvider"
                providerId="dart.declarative.type.hints"
                language="Dart"
                group="TYPES_GROUP"
                isEnabledByDefault="true"
                bundle="messages.FlutterToolsBundle"
                nameKey="dart.type.hints.name"/>

        <!-- Dart Code Vision (Usage Lens) -->
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="dev.rutvik.flutter_developer_tools.dart.codeVision.DartReferencesCodeVisionProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="dev.rutvik.flutter_developer_tools.dart.codeVision.DartInheritorsCodeVisionProvider"/>

        <!-- Enhanced Dart Documentation with Syntax Highlighting -->
        <lang.documentationProvider
                language="Dart"
                implementationClass="dev.rutvik.flutter_developer_tools.dart.documentation.DartEnhancedDocumentationProvider"
                order="first"/>

        <!-- Enhanced Dart Breadcrumbs -->
        <breadcrumbsInfoProvider
                implementation="dev.rutvik.flutter_developer_tools.dart.breadcrumbs.DartBreadcrumbsProvider"/>

        <!-- Cache invalidators -->
        <cachesInvalidator implementation="dev.rutvik.flutter_developer_tools.startup.PubCacheInvalidator"/>

        <!-- Settings -->
        <applicationService
                serviceImplementation="dev.rutvik.flutter_developer_tools.settings.BreadcrumbsSettingsState"/>

        <applicationConfigurable
                parentId="tools"
                instance="dev.rutvik.flutter_developer_tools.settings.BreadcrumbsConfigurable"
                id="dev.rutvik.flutter_developer_tools.settings.BreadcrumbsConfigurable"
                displayName="Flutter Developer Tools"/>

        <!-- Notification Groups -->
        <notificationGroup id="Flutter Developer Tools"
                           displayType="BALLOON"/>
    </extensions>

    <applicationListeners>
        <listener
                class="dev.rutvik.flutter_developer_tools.startup.StartupPreloader"
                topic="com.intellij.ide.AppLifecycleListener"/>

        <listener class="dev.rutvik.flutter_developer_tools.listeners.PubspecFileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>
</idea-plugin>
