<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.rutvik.flutter_developer_tools.flutter_developer_tools</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Flutter Developer Tools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://rutvik.dev">Rutvik Dev</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
    <h2>Advanced Pubspec.yaml Intelligence for Flutter & Dart</h2>
    <p>Features:</p>
    <ul>
        <li>Smart auto-complete for pub.dev packages showing Flutter favorites and likes count</li>
        <li>Package names and versions can be opened on pub.dev using CMD+click (or similar)</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <h3>Version 1.0.0</h3>
    <ul>
        <li>Initial release</li>
        <li>Added package auto-completion with Flutter favorites and likes</li>
        <li>Added hyperlink support to open packages on pub.dev</li>
    </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>io.flutter</depends>
    <depends>Dart</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Application Services -->
        <applicationService
                serviceImplementation="dev.rutvik.flutter_developer_tools.services.PubPackageCacheService"/>

        <!-- Pub Package Completion -->
        <completion.contributor
                language="yaml"
                order="first"
                implementationClass="dev.rutvik.flutter_developer_tools.pubspec.completions.PubPackageCompletionContributor"/>

        <!-- Reference Contributor -->
        <psi.referenceContributor
                language="yaml"
                implementation="dev.rutvik.flutter_developer_tools.pubspec.referenceContributor.PubPackageReferenceContributor"/>

        <!-- Annotator -->
        <annotator language="yaml" order="first"
                   implementationClass="dev.rutvik.flutter_developer_tools.pubspec.annotator.PubPackageAnnotator"/>

        <!-- Cache invalidators -->
        <cachesInvalidator implementation="dev.rutvik.flutter_developer_tools.startup.PubCacheInvalidator"/>
    </extensions>

    <applicationListeners>
        <listener
                class="dev.rutvik.flutter_developer_tools.startup.StartupPreloader"
                topic="com.intellij.ide.AppLifecycleListener"/>

        <listener class="dev.rutvik.flutter_developer_tools.listeners.PubspecFileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>
</idea-plugin>